{
  "name": "ai-proxy-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch dev-server.ts",
    "dev:web": "pnpm --filter @ai-proxy/web dev",
    "build": "pnpm --filter @ai-proxy/web build",
    "start": "tsx dev-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.0.1",
    "cors": "^2.8.5",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
