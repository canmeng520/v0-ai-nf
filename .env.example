# Bearer token clients must send to authenticate against the proxy
PROXY_API_KEY=123

# ---- Upstream credentials (resolved in this order: override -> platform -> gateway) ----

# 1. v0 AI Integrations (auto-injected by v0). Key + base URL are paired.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# 2. Standard SDK vars. Netlify's AI Gateway injects these automatically on
#    AI-enabled sites (key + matching base URL for each provider).
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 3. Unified gateway fallback (no per-provider keys needed).
#    Vercel AI Gateway (or its OIDC token, injected per-invocation on Vercel):
AI_GATEWAY_API_KEY=
#    Netlify AI Gateway explicit key + base URL:
NETLIFY_AI_GATEWAY_KEY=
NETLIFY_AI_GATEWAY_BASE_URL=

# Server port for the API (local / Vercel only)
PORT=8787

# Set to 1 to allow GET /v1/models?debug=1 to return upstream probe diagnostics
# (base URLs / hosts). OFF by default so the upstream channel is never exposed.
ALLOW_MODELS_DEBUG=

# ---- Reliability tunables (all optional) ----

# Credential-chain failover: when the primary upstream exhausts its retries on a
# failover-worthy error (network/401/403/404/429/5xx), the gateway advances to
# the next resolvable credential (override -> platform -> gateway). Set to 0 to
# pin to the primary only.
UPSTREAM_FAILOVER=

# Abort an upstream stream that goes silent mid-stream for this long (ms) and
# emit a protocol-correct error instead of hanging. Default 90000; 0 disables.
STREAM_STALL_TIMEOUT_MS=

# Ride-out windows before giving up on a transiently-failing upstream (ms).
UPSTREAM_STREAM_RETRY_MS=
UPSTREAM_NONSTREAM_RETRY_MS=

# How many times to retry a 403 before forwarding it. A 403 is usually a hard
# error, but some gateways (Netlify AI Gateway under bursty load) return a
# short-lived protection-window 403 that clears in a couple seconds. Default 2;
# set 0 to disable (forward the first 403 immediately).
RETRY_403_MAX=

# Optional client->upstream model renaming, comma-separated `from=to` pairs.
# Example: MODEL_MAP=gpt-4=gpt-5.4,claude-3-5-sonnet-20241022=claude-sonnet-5
MODEL_MAP=

# Optional multi-IP egress. When set, upstream requests rotate (round-robin)
# across these HTTP proxies so the upstream sees many source IPs. Only helps
# upstreams that limit by SOURCE IP (e.g. a direct distributor) — it does NOT
# help an account-keyed gateway like the Netlify AI Gateway, and is skipped
# automatically for *.netlify.app / .netlify/ai targets. Best used on a
# self-hosted / VPS deployment. One proxy per line or comma-separated; each is
# `host:port`, `host:port:user:pass`, or a full `http://user:pass@host:port` URL.
# Example: UPSTREAM_PROXIES=157.238.79.132:43000:msxv09v1:msxv09v1,157.238.79.156:43000:msxv09v2:msxv09v2
UPSTREAM_PROXIES=
