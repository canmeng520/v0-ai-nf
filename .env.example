# Bearer token clients must send to authenticate against the proxy
PROXY_API_KEY=123

# ---- Upstream credentials (resolved in this order: override -> platform -> gateway) ----

# 1. v0 AI Integrations (auto-injected by v0). Key + base URL are paired.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# 2. Standard SDK vars. Netlify's AI Gateway injects these automatically on
#    AI-enabled sites (key + matching base URL for each provider).
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 3. Unified gateway fallback (no per-provider keys needed).
#    Vercel AI Gateway (or its OIDC token, injected per-invocation on Vercel):
AI_GATEWAY_API_KEY=
#    Netlify AI Gateway explicit key + base URL:
NETLIFY_AI_GATEWAY_KEY=
NETLIFY_AI_GATEWAY_BASE_URL=

# Server port for the API (local / Vercel only)
PORT=8787

# Set to 1 to allow GET /v1/models?debug=1 to return upstream probe diagnostics
# (base URLs / hosts). OFF by default so the upstream channel is never exposed.
ALLOW_MODELS_DEBUG=
